# Tigim — environment variables
# Copy this file to .env.local and fill values. Do NOT commit .env.local.

# ----- Lead form endpoint -----
# Pick ONE of: Formspree, Web3Forms, Tally.so, or your own backend.
# When empty, the demo-request form falls back to localStorage (dev/staging).
#
# Formspree example: https://formspree.io/f/xxxxxxx
# Web3Forms example: https://api.web3forms.com/submit  (then set VITE_FORM_ACCESS_KEY)
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=

# ----- Analytics -----
# Plausible: just put your domain (e.g. tigim.app). Script is loaded automatically.
VITE_PLAUSIBLE_DOMAIN=

# Google Analytics 4: measurement ID like G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# ----- Supabase (filled at Step 8) -----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
