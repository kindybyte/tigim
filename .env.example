# Tigim — environment variables
# Copy this file to .env.local and fill values. Do NOT commit .env.local.

# ----- Lead form -----
# Заявки с формы «Получить демо» пишутся напрямую в Supabase таблицу `leads`
# (RLS-политика разрешает anonymous insert). Никаких env vars для самой записи
# не нужно — достаточно VITE_SUPABASE_* ниже.
#
# Опционально: Telegram-уведомления о новой заявке (см. секцию ниже).

# ----- Analytics -----
# Plausible: just put your domain (e.g. tigim.app). Script is loaded automatically.
VITE_PLAUSIBLE_DOMAIN=

# Google Analytics 4: measurement ID like G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# ----- Supabase (filled at Step 8) -----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ----- AI assistant (Step 19) -----
# Anthropic API key from console.anthropic.com — SERVER-ONLY, never expose to browser.
# Set in Vercel as "ANTHROPIC_API_KEY" (without VITE_ prefix).
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-haiku-4-5-20251001 (cheapest, fastest).
ANTHROPIC_MODEL=

# Server-side Supabase env vars used by /api/ai/chat.
# Mirror the VITE_* ones; service role bypasses RLS for company lookup and usage write.
# Set these in Vercel WITHOUT the VITE_ prefix.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Telegram notifications -----
# Опционально. Бот от @BotFather → токен вида 1234567890:AAH...
# chat_id — твой личный чат с ботом (после /start → api.telegram.org/bot<TOKEN>/getUpdates)
# или ID группы (если создашь группу для команды).
# При пустых значениях /api/lead-notify тихо отвечает OK и не падает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel Cron secret — Vercel автоматически генерирует и кладёт в env vars
# при подключении cron. Если задан, /api/check-subscriptions проверяет
# Authorization: Bearer ${CRON_SECRET} и отвергает чужие запросы.
CRON_SECRET=
